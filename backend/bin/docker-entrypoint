#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# If running the rails server then create or migrate existing database
if [ "$1" == "./bin/rails" ] && [ "$2" == "server" ]; then
  ./bin/rails db:prepare

  # Load Solid Queue and Solid Cache schemas if their tables don't exist yet.
  # db:prepare skips schema loading for queue/cache when they share the primary DATABASE_URL.
  ./bin/rails runner "
    conn = ActiveRecord::Base.connection
    unless conn.table_exists?(:solid_queue_jobs)
      load Rails.root.join('db/queue_schema.rb')
    end
    unless conn.table_exists?(:solid_cache_entries)
      load Rails.root.join('db/cache_schema.rb')
    end
  "
fi

exec "${@}"
